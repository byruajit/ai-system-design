# ---- source API ----------------------------------------------------------
QF_API_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
QF_MIN_MAGNITUDE=2.5
QF_LOOKBACK_DAYS=7
QF_EVENT_TYPES=earthquake
QF_PAGE_LIMIT=2000
QF_MAX_PAGES=25
QF_REQUEST_TIMEOUT=30
QF_MAX_RETRIES=4

# ---- warehouse -----------------------------------------------------------
# Either set the full URL...
# QF_DATABASE_URL=postgresql+psycopg2://quake:quake@localhost:5433/quakeflow
# ...or the individual parts:
QF_DB_USER=quake
QF_DB_PASSWORD=quake
QF_DB_HOST=localhost
QF_DB_PORT=5433
QF_DB_NAME=quakeflow
QF_DB_SCHEMA=quakeflow

# ---- local storage / logging --------------------------------------------
QF_BRONZE_DIR=data/bronze
QF_WRITE_BRONZE=true
QF_LOG_LEVEL=INFO
